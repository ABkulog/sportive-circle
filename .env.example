# Copy these into your host's "environment variables" settings. Never commit real values.

# Required: a long random string. Make one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The site's public address (https). Used in emails, calendar files and share links.
PUBLIC_URL=https://your-app.example.com

# Set to 1 on hosts that put a proxy in front of the app (Render, Railway, Fly.io, Heroku...).
BEHIND_PROXY=1

# Where the database lives. Put it on a persistent disk so it survives redeploys.
DATABASE=/data/sportive_circle.db

# Who can review reports and club registrations (comma-separated UW emails).
ADMIN_EMAILS=you@uw.edu

# Shown on the Privacy and Terms pages for questions and appeals. Use the app's own email, not a personal one.
CONTACT_EMAIL=

# Email for codes and reminders (any SMTP provider: e.g. SendGrid, Mailgun, Amazon SES, Gmail app password).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional "From" line, e.g.: Sportive Circle <hello@your-domain.com>  (defaults to MAIL_USERNAME)
MAIL_FROM=
